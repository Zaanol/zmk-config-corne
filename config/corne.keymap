#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define WIN_BASE 0
#define WIN_LOWER 1
#define WIN_RAISE 2
#define MAC_BASE 3
#define MAC_LOWER 4
#define MAC_RAISE 5
#define WIN_FUNC 6
#define MAC_FUNC 7
#define NUM 8
#define GAMER 9

/ {
    combos {
        compatible = "zmk,combos";

        Scape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_base_layer {
            display-name = "Win";

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E             &kp R               &kp T        &kp Y         &kp U      &kp I            &kp O    &kp P             &kp BACKSPACE
&kp LALT   &kp A  &kp S  &kp D             &kp F               &kp G        &kp H         &kp J      &kp K            &kp L    &kp SINGLE_QUOTE  &sk RIGHT_ALT
&kp LSHFT  &kp Z  &kp X  &kp C             &kp V               &kp B        &kp N         &kp M      &kp COMMA        &kp DOT  &kp FSLH          &sl WIN_FUNC
                         &kp LEFT_CONTROL  &mt LEFT_GUI ENTER  &lt WIN_LOWER TAB  &lt WIN_RAISE DELETE  &kp SPACE  &sk RIGHT_SHIFT
            >;
        };

        win_lower_layer {
            display-name = "Win Lower";

            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp POUND     &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6     &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0           &trans
&trans  &trans           &kp TILDE     &kp GRAVE     &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans        &trans                &kp LEFT_WIN           &trans
                                       &trans        &trans            &trans            &kp BACKSPACE    &trans             &kp COLON
            >;
        };

        win_raise_layer {
            display-name = "Win Raise";

            bindings = <
&trans  &kp DELETE     &trans            &kp UNDERSCORE  &kp PLUS     &kp PAGE_UP      &trans            &trans          &trans           &kp BACKSLASH      &kp PIPE         &trans
&trans  &kp HOME       &kp END           &kp MINUS       &kp EQUAL    &kp PAGE_DOWN    &kp LEFT          &kp DOWN        &kp UP_ARROW     &kp RIGHT          &kp K_MENU       &trans
&trans  &kp LESS_THAN  &kp GREATER_THAN  &kp LC(C)       &kp LC(V)    &kp SEMICOLON    &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
                                         &kp ESCAPE      &trans       &kp SEMI         &trans            &trans          &sk RIGHT_SHIFT
            >;
        };

        mac_base_layer {
            display-name = "Mac";

            bindings = <
&kp TAB       &kp Q  &kp W  &kp E             &kp R                  &kp T        &kp Y         &kp U      &kp I            &kp O    &kp P             &kp BACKSPACE
&kp LEFT_ALT  &kp A  &kp S  &kp D             &kp F                  &kp G        &kp H         &kp J      &kp K            &kp L    &kp SINGLE_QUOTE  &sk RIGHT_ALT
&kp LSHFT     &kp Z  &kp X  &kp C             &kp V                  &kp B        &kp N         &kp M      &kp COMMA        &kp DOT  &kp FSLH          &sl MAC_FUNC
                            &kp LEFT_GUI      &mt LEFT_CONTROL ENTER  &lt MAC_LOWER TAB  &lt MAC_RAISE DELETE  &kp SPACE  &sk RIGHT_SHIFT
            >;
        };

        mac_lower_layer {
            display-name = "Mac Lower";

            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp POUND     &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6     &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0           &trans
&trans  &trans           &kp TILDE     &kp GRAVE     &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans        &trans                &kp LEFT_GUI           &trans
                                       &trans        &trans            &trans            &kp BACKSPACE    &trans             &kp COLON
            >;
        };

        mac_raise_layer {
            display-name = "Mac Raise";

            bindings = <
&trans  &kp DELETE     &trans            &kp UNDERSCORE  &kp PLUS     &kp PAGE_UP      &trans            &trans          &trans           &kp BACKSLASH      &kp PIPE         &trans
&trans  &kp HOME       &kp END           &kp MINUS       &kp EQUAL    &kp PAGE_DOWN    &kp LEFT          &kp DOWN        &kp UP_ARROW     &kp RIGHT          &kp LG(SPACE)    &trans
&trans  &kp LESS_THAN  &kp GREATER_THAN  &kp LG(C)       &kp LG(V)    &kp SEMICOLON    &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
                                         &kp ESCAPE      &trans       &kp SEMI         &trans            &trans          &sk RIGHT_SHIFT
            >;
        };

        win_function_layer {
            display-name = "Win Fn";

            bindings = <
&to WIN_BASE     &kp F1    &kp F2   &kp F3            &kp F4             &kp F5               &kp F6            &kp F7          &kp F8         &kp F9  &kp F10     &to WIN_BASE
&to GAMER        &kp F11   &kp F12  &trans            &trans             &trans               &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2   &trans  &bt BT_CLR  &to MAC_BASE
&kp LA(INSERT)   &kp CAPS  &trans   &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG    &ext_power EP_ON  &rgb_ug RGB_ON  &bt BT_DISC 2  &trans  &to WIN_BASE  &kp PRINTSCREEN
                                    &trans            &trans             &mo NUM              &kp BACKSPACE     &trans          &trans
            >;
        };

        mac_function_layer {
            display-name = "Mac Fn";

            bindings = <
&to WIN_BASE     &kp F1    &kp F2   &kp F3            &kp F4             &kp F5               &kp F6            &kp F7          &kp F8         &kp F9  &kp F10     &to WIN_BASE
&to GAMER        &kp F11   &kp F12  &trans            &trans             &trans               &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2   &trans  &bt BT_CLR  &to MAC_BASE
&kp LG(SPACE)    &kp CAPS  &trans   &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG    &ext_power EP_ON  &rgb_ug RGB_ON  &bt BT_DISC 2  &trans  &to MAC_BASE  &kp LS(LG(NUMBER_4))
                                    &trans            &trans             &mo NUM              &kp BACKSPACE     &trans          &trans
            >;
        };

        number_layer {
            display-name = "Num";

            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &trans       &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans        &trans    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans       &trans
&trans  &trans  &trans  &trans  &trans        &trans    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS     &kp KP_PLUS  &trans
                        &trans  &kp KP_ENTER  &trans    &trans           &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };

        gamer_layer {
            display-name = "Gamer";

            bindings = <
&kp NUMBER_1      &kp Q  &kp W  &kp E      &kp R               &kp T        &kp Y         &kp U      &kp I      &kp O    &kp P             &kp BACKSPACE
&sk LEFT_SHIFT    &kp A  &kp S  &kp D      &kp F               &kp G        &kp H         &kp J      &kp K      &kp L    &kp SINGLE_QUOTE  &sk RIGHT_ALT
&sk LEFT_CONTROL  &kp Z  &kp X  &kp C      &kp V               &kp B        &kp N         &kp M      &kp COMMA  &kp DOT  &kp FSLH          &sl WIN_FUNC
                                &kp SPACE  &mt LEFT_GUI ENTER  &lt WIN_LOWER TAB  &lt WIN_RAISE DELETE  &kp SPACE  &to WIN_BASE
            >;
        };
    };
};
